# Bring-up only, installed on userdebug builds: on-screen boot report.
# Started at init, so it also runs when the boot never gets past mounting /data.
service vendor.bringup_report /vendor/bin/bringup-report.sh
    user root
    group root log
    seclabel u:r:su:s0
    oneshot
    disabled

on early-init
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode 1
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral

on init
    start vendor.bringup_report
    setprop persist.sys.debug_enabled 1
    setprop service.adb.root 1
    setprop sys.usb.configfs 1
    setprop sys.usb.controller a600000.dwc3
    setprop vendor.usb.controller a600000.dwc3
    setprop sys.usb.config adb
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode 1
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 system usb
    mkdir /config/usb_gadget/g1/strings/0x409 0770 system usb
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb 0770 system usb
    mkdir /config/usb_gadget/g1/configs/b.1 0770 system usb
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 system usb
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    write /config/usb_gadget/g1/configs/b.1/MaxPower 900
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /dev/usb-ffs 0775 shell system
    mkdir /dev/usb-ffs/adb 0770 shell system
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=1000,rmode=0770,fmode=0660
    start adbd

on property:vendor.all.modules.ready=1
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode 2
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/a600000.dwc3 2
    setprop sys.usb.controller a600000.dwc3
    setprop vendor.usb.controller a600000.dwc3
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb
    start adbd
    setprop service.adb.root 1

on property:vendor.all.modules.ready=1 && property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    wait /sys/class/udc/a600000.dwc3 5
    write /config/usb_gadget/g1/UDC a600000.dwc3
    setprop sys.usb.state adb

on early-boot
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode 2
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral

on boot
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode 2
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/a600000.dwc3 2
    setprop sys.usb.controller a600000.dwc3
    setprop vendor.usb.controller a600000.dwc3
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb
    start adbd
    setprop service.adb.root 1

on property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    wait /sys/class/udc/a600000.dwc3 5
    write /config/usb_gadget/g1/UDC a600000.dwc3
    setprop sys.usb.state adb

# Allow "adb root" by default (LineageOS keeps this switch in /data/adbroot/enabled).
on post-fs-data
    mkdir /data/adbroot 0700 root root
    write /data/adbroot/enabled 1
    setprop persist.sys.debug_enabled 1
    setprop service.adb.root 1
    mkdir /data/misc/adb 02750 system shell
    copy /vendor/etc/security/adb_keys /data/misc/adb/adb_keys
    chmod 0640 /data/misc/adb/adb_keys
    chown system shell /data/misc/adb/adb_keys
    restart adbd
