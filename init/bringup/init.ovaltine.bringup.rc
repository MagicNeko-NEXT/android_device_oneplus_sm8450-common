# Bring-up only, installed on userdebug builds: on-screen boot report.
# Started at init, so it also runs when the boot never gets past mounting /data.
service vendor.bringup_report /vendor/bin/bringup-report.sh
    user root
    group root log
    seclabel u:r:su:s0
    oneshot
    disabled

on init
    start vendor.bringup_report
    setprop persist.sys.debug_enabled 1
    setprop service.adb.root 1

on early-boot
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode 2
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    chmod 0664 /sys/kernel/snd_card/card_state
    chown audioserver audio /sys/kernel/snd_card/card_state
    write /sys/kernel/snd_card/card_state 1

on boot
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode 2
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    setprop service.adb.root 1
    chmod 0664 /sys/kernel/snd_card/card_state
    chown audioserver audio /sys/kernel/snd_card/card_state
    write /sys/kernel/snd_card/card_state 1

# Allow "adb root" by default (LineageOS keeps this switch in /data/adbroot/enabled).
on post-fs-data
    mkdir /data/adbroot 0700 root root
    write /data/adbroot/enabled 1
    setprop persist.sys.debug_enabled 1
    setprop service.adb.root 1
    mkdir /data/misc/adb 02750 system shell
    copy /vendor/etc/security/adb_keys /data/misc/adb/adb_keys
    chmod 0640 /data/misc/adb/adb_keys
    chown system shell /data/misc/adb/adb_keys
    restart adbd
