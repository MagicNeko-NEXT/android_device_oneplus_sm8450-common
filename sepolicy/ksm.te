# KSM (kernel samepage merging): lets the post_boot script start it at boot
#
# Background (tested 2026-10-10, ovaltine):
#   /sys/kernel/mm/ksm/* defaults to the generic sysfs type, and vendor_qti_init_shell
#   has read-only access to generic sysfs (AOSP: allow init sysfs_type:file { getattr read }),
#   so when configure_memory_extension() in init.kernel.post_boot-cape.sh writes
#   pages_to_scan / sleep_millisecs / use_zero_pages / run, SELinux blocks all of it.
#   Symptom: the kernel has CONFIG_KSM and /sys/kernel/mm/ksm exists, but run is always 0.
#   (zram isn't affected: /sys/block/zram0 has a dedicated sysfs_zram type that QTI already allows.)
#
# Following the sysfs_zram precedent: give the KSM nodes a dedicated type, then allow it separately.
# Rollback: delete this file and the genfscon line in genfs_contexts in the same directory.

type sysfs_ksm, fs_type, sysfs_type;

# The post_boot script's domain: needs to write KSM parameters
allow vendor_qti_init_shell sysfs_ksm:dir r_dir_perms;
allow vendor_qti_init_shell sysfs_ksm:file rw_file_perms;

# init / vendor_init: read-only, for boot observation and troubleshooting
allow init sysfs_ksm:dir r_dir_perms;
allow init sysfs_ksm:file r_file_perms;
allow vendor_init sysfs_ksm:dir r_dir_perms;
allow vendor_init sysfs_ksm:file r_file_perms;
