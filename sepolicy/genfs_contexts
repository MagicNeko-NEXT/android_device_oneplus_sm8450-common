# KSM: dedicated label for /sys/kernel/mm/ksm (the default is generic sysfs, which nobody can write)
genfscon sysfs /kernel/mm/ksm u:object_r:sysfs_ksm:s0

# SPI4 (eSE/NFC) wakeup node for system_suspend
genfscon sysfs /devices/platform/soc/9c0000.qcom,qupv3_0_geni_se/990000.spi/spi_master/spi4/spi4.0/wakeup u:object_r:sysfs_wakeup:s0

# OPlus FTM mode node read by vendor_modprobe.sh
genfscon sysfs /systeminfo/ftmmode u:object_r:sysfs_systeminfo:s0
