diff --git a/arch/arm64/configs/vendor/oplus/ksm.config b/arch/arm64/configs/vendor/oplus/ksm.config
new file mode 100644
index 000000000000..d7706b339c20
--- /dev/null
+++ b/arch/arm64/configs/vendor/oplus/ksm.config
@@ -0,0 +1,10 @@
+# Memory reclaim enhancement (ovaltine custom, 2026-10-10)
+#
+# Why this line must be explicit:
+#   KSM appears in neither gki_defconfig nor any vendor fragment, so make gki_defconfig
+#   leaves it at the kernel default n (the resulting .config has "# CONFIG_KSM is not set"),
+#   so the whole /sys/kernel/mm/ksm directory is absent and it can't be enabled at runtime.
+#   This adds a fragment at the end of TARGET_KERNEL_CONFIG to override the default.
+# Dependency: KSM selects XXHASH, and this device already has CONFIG_XXHASH=y, so no further impact.
+# Rollback: delete this file and remove vendor/oplus/ksm.config from BoardConfigCommon.mk.
+CONFIG_KSM=y
